{
  "manifest_version": 3,
  "name": "Coursera Text Exporter",
  "description": "Collect captions and readings through the course API with resumable jobs, local export, and Google Drive sync.",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "permissions": ["identity", "storage", "alarms", "downloads", "offscreen"],
  "host_permissions": [
    "https://www.coursera.org/*",
    "https://www.googleapis.com/*",
    "https://d3c33hcgiwev3.cloudfront.net/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Coursera Text Exporter"
  },
  "content_scripts": [
    {
      "matches": ["https://www.coursera.org/*"],
      "js": ["content/course-context.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
